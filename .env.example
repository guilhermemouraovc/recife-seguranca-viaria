# Variáveis que o docker-compose.yml consome. Copie para .env (que não é versionado):
#   cp .env.example .env

# PostgreSQL (serviço postgres). A senha entra na URI do MLflow: evite @ : / ? # % nela.
POSTGRES_USER=viario
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=viario
# Porta no host. 5433 para não conflitar com um Postgres instalado localmente na 5432.
POSTGRES_PORT=5433

# MQTT (serviço mosquitto). O broker não aceita conexão anônima.
MQTT_USER=viario
MQTT_PASSWORD=troque-esta-senha-mqtt
MQTT_PORT=1883

# MLflow (serviço mlflow). No macOS a 5000 costuma estar ocupada pelo AirPlay: use 5001.
MLFLOW_PORT=5000

# Jupyter (serviço jupyter, profile dev). O token é a senha de acesso pelo navegador.
JUPYTER_TOKEN=troque-este-token
JUPYTER_PORT=8888

# UID com que os containers Python gravam em ./data e ./notebooks. Mesma convenção do Airflow.
# Windows e macOS (Docker Desktop): deixe 50000. Linux: use a saída de `id -u`.
AIRFLOW_UID=50000
