# Variáveis que o docker-compose.yml consome. Copie para .env (que não é versionado):
#   cp .env.example .env

# PostgreSQL (serviço postgres)
POSTGRES_USER=viario
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=viario
# Porta no host. 5433 para não conflitar com um Postgres instalado localmente na 5432.
POSTGRES_PORT=5433

# UID com que os containers Python gravam em ./data. Mesma convenção do Airflow, que entra na
# próxima rodada. Windows e macOS (Docker Desktop): deixe 50000. Linux: use a saída de `id -u`.
AIRFLOW_UID=50000
