# Dados: só a estrutura e o manifesto vão para o git
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/adhoc/*
!data/adhoc/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Credenciais (copie .env.example para .env)
.env
secrets.h

# Ferramenta local de agente (as pastas de agentes do Projeto 6 são versionadas)
.serena/
.claude/settings.local.json

# Embarcado (PlatformIO) e editor
.pio/
.vscode/
.DS_Store
